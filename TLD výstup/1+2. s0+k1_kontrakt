  performance: 'Úleva mění pouze projev: STEADIER; bez úlevy UNEASY_BUT_FUNCTIONAL. Sama nevytváří další větev textu.'
  rounds:
    GREEN_BLOOD:
      choices:
        K1_SCENE_CAUTIOUS_MEDICAL:
          intent: LIMIT_TO_SUPPORTED_INFERENCE
          benefits: Reason
          knowledge_risk: LOW
        K1_SCENE_CHEMISTRY:
          intent: ACKNOWLEDGE_ANOMALY_WITHOUT_CLAIMING_ORIGIN
          benefits: Chemistry
          knowledge_risk: LOW
        K1_SCENE_TOO_PRECISE:
          intent: OVERREVEAL_HYDE_ONLY_KNOWLEDGE
          knowledge_risk: HIGH
          rule: Route through knowledge_legitimacy.TOO_PRECISE unless equivalent detail is legitimately supported by
            current evidence.
      on_enter: set K1GreenBloodExamined = true
      optional_sample:
        condition: Po prohlédnutí zelené krve.
        intent: Odebrat vzorek pro pozdější rozbor.
        on_collect:
        - set K1HydeBloodSampleCollected = true
        - add HYDE_BLOOD_SAMPLE x1
        on_skip: Continue without sample; K1 remains completable.
    FIGHT_RECONSTRUCTION:
      choices:
        K1_SCENE_VISIBLE_RECONSTRUCTION:
          intent: LIMIT_TO_VISIBLE_RECONSTRUCTION
          benefits: Reason
          knowledge_risk: LOW
        K1_SCENE_GANG_VIOLENCE:
          availability: K1NewspaperRead == true
          legitimacy_source: NEWSPAPER_PUBLIC_FACT
          intent: PROPOSE_PLAUSIBLE_CRIMINAL_CONTEXT
          benefits: Society
          knowledge_risk: LOW
          writes:
          - K1GangViolenceHypothesisRaised = true
          rule: 'This option exists only because the newspaper made Rook''s criminal reputation legitimate Jekyll knowledge.
            It is a hypothesis, not a confirmed solution to the murder.

            '
        K1_SCENE_EXACT_RECONSTRUCTION:
          intent: RECONSTRUCT_TOO_EXACTLY
          knowledge_risk: HIGH
          rule: Hyde-only sequencing routes through knowledge_legitimacy.TOO_PRECISE and raises suspicion.
    CLOSING_LEDGER:
      intent: Newcomen sdělí, že Rookova účetní kniha chybí; Jekyll označí její možný význam pro vyšetřování.
      if_sample_collected: Newcomen žádá výsledek budoucího rozboru a Jekyll souhlasí. TLD pro tento příslib nedefinuje
        samostatný nový flag.
  too_precise:
    condition: Jekyll uses PLAYER_SECRET without legitimate source
    writes:
      Exposure: 10
      NewcomenSuspicion: 15
      ProfessionalStanding: -5
  completion: K1CrimeSceneConsultationComplete=true. Pozdější kapitoly navazují na již proběhlou konzultaci a deklarované
    výsledky, nikoli na nový požadavek pamatovat každou větu.
  text_work_later: Finální repliky mají vyjádřit níže uvedené intenty při zachování podmínek a mechaniky. Jejich samotná
    formulace nevytváří nové následky.
