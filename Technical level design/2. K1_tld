  - resolve selected authored Potency/Purity result
  - apply SerumInstabilityScar +15 only for K1_RISKY
  - create one immediately usable first-experiment serum dose
  - set SerumStock = 1
  - set K1BrewChoiceResolved = true
  - set K1SerumPrepared = true
  - 'advance authored clock by method: PRECISE +20 / FAST +8 / RISKY +12 minutes'
  - call SerumRecipeMastery eligibility check
  - complete OBJ_K1_COMPLETE_EXPERIMENT
  - activate OBJ_K1_TAKE_SERUM
