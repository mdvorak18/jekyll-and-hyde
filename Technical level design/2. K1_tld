schema:
  id: JH_AMDD_K1_TECHNICAL_LEVEL_DESIGN
  version: '1.7'
  status: UPDATED_AUTHORED_TIME_AND_AUTOMATIC_JOURNAL_BASELINE
  chapter: K1
  world: MANUSCRIPT
  level_id: L_K1_EXPERIMENT_AND_ROOK
  purpose: >
    Full greybox-ready Technical Level Design baseline for K1. K1 consumes the S0 AuthorPacket/MotifPacket, stages the first serum experiment and transformation in Jekyll's professional laboratory, introduces Hyde through a short night-street sequence, resolves a seamless Rook confrontation and systemic knife fight, commits Rook's fixed post-threat death, then fades through an authored overnight reversion into ManuscriptDay 2. Jekyll wakes at home to Poole's message that Inspector Newcomen requires him at the Rook scene, explores the house under authored morning time pressure, may discover the incriminating bloodied coat, may optionally read a newspaper and realize the ÚLEVA motif, and attends an initial on-site consultation with Newcomen. K1 v1.6 also locks the compact Day-2 home exploration: bedroom + salon + entry hall, Fidelity-dependent laboratory-door labeling, LUCID clue salience, a FRAGMENTARY-only abstract wash action, universal mirror access and generic route-check ContextMod use rather than Newcomen-specific temporary stats. It retains late home coat correction, the bloodied-coat capture consequence, bounded Newcomen dialogue, optional green-blood sample collection and the downstream research seed that Hyde blood plus CATALYST may later yield STABILIZER once the recipe is discovered. Exact final performance prose, combat tuning, death choreography, UI art and cinematic shot design remain downstream.
authority:
  priority:
  - MASTER
  - NARRATIVE_FLOW
  - TECHNICAL_LEVEL_DESIGN
  - DIALOGUE_AND_CINEMATIC_DETAIL
  master_source: JH_MASTER(2).yaml
  narrative_flow_source: JH_Narrative Flow(1).yaml
  previous_chapter_tld: 1. S0_tld
  conflict_rule: 'MASTER remains highest authority. K1 v1.6 contains user-approved design revisions that require upstream
    master/narrative-flow synchronization: systemic inference of K1_ROOK style instead of a player-facing route choice; canonical
    first Rook knife wound with green Hyde blood and no Day-2 Jekyll wound; overnight authored reversion/fade instead of a
    playable escape-reversion route; optional newspaper/ÚLEVA; and an initial Newcomen crime-scene consultation inside K1.
    Until synchronized, these blocks are the approved K1 implementation target but must not silently rewrite other chapters.
    Numbers marked TUNING are implementation defaults.'
  master_bindings:
    chapter_topology: story.K1
    manuscript_time: manuscript_time
    professional_system: professional_system
    reagent_system: reagent_system
    persistent_state: persistent_state
    hyde_dependence: hyde_dependence
    serum: serum
    form_system: form_system
    required_reversion: required_reversion
    motifs: motifs
    research: research
    world_memory: world_memory
    knowledge_legitimacy: knowledge_legitimacy
    author_packet: author_packet
    author_weather: author_weather
    chapter_weather_baseline: chapter_weather_baselines.K1
    hard_fail: hard_fail_matrix.K1
    form_visual_language: form_visual_language.HYDE
    quick_action_system: quick_action_system
    route_check: route_check
    combat_system: PENDING_MASTER_SYNC
  dialogue_source:
    file: JH_AMDD_K1_dialogue.yaml
    status: NOT_YET_AUTHORED
    rule: TLD defines where dialogue occurs, what it must accomplish, which choice IDs are available and which state writes
      fire. Final spoken lines and performance directions belong in the dialogue file.
canonical_contract:
  entry:
    Form: JEKYLL
    SerumStock: 0
    ManuscriptDay: 1
    TimeOfDay: NIGHT
    K1LocalClockMinutes: 1260
    source: story.K1.entry + manuscript_time
  main_objective: complete the first experiment; survive Hyde's first night; face the first police consequences
  form_policy:
    experiment: JEKYLL_REQUIRED
    Rook: HYDE_LOCKED
    Day2_home_and_investigation: JEKYLL_REQUIRED
  forced_beats:
  - id: K1_RECEIVE_S0_PACKET
    event: K1 receives and applies the S0 AuthorPacket and MotifPacket.
  - id: K1_JEKYLL_EXPERIMENT
    event: Jekyll conducts the first serum experiment in the PROFESSIONAL laboratory.
  - id: K1_FIRST_TRANSFORMATION
    event: The experiment causes the first transformation into Hyde without blackout.
  - id: K1_HYDE_STREET_RELEASE
    event: Hyde reaches the night street and receives a short first-control/instinct sequence.
  - id: K1_ROOK_LIVE_APPROACH
    event: Rook confronts Hyde in live gameplay; the opening dialogue is not a cutscene.
  - id: K1_ROOK_FIRST_STAB
    event: All opening reactions converge on Rook landing one canonical nonfatal knife wound on Hyde.
    fixed_truth: true
  - id: K1_ROOK_SYSTEMIC_FIGHT
    event: The fight becomes systemic combat. A second clean penetrating knife hit kills Hyde.
  - id: K1_ROOK_THREAT_ENDS
    event: Rook becomes clearly incapacitated/disarmed before the fixed death beat.
  - id: K1_ROOK_POST_FIGHT_EXPRESSION
    event: Hyde receives a brief live expressive choice after Rook is no longer a threat.
  - id: K1_ROOK_DIES
    event: Rook dies only after the immediate threat has ended.
    fixed_truth: true
  - id: K1_LEDGER_MISSING
    event: Rook's ledger is missing after the incident.
    fixed_truth: true
  - id: K1_OVERNIGHT_FADE
    event: K1 fades to black after the Rook aftermath and resolves a non-magical overnight reversion offscreen.
  - id: K1_JEKYLL_WAKE_DAY2
    event: Poole wakes Jekyll on ManuscriptDay 2. Jekyll has no wound or scar from Rook’s canonical stab.
  - id: K1_POOLE_MESSAGE
    event: Poole reports that a police messenger/constable came on behalf of Inspector Newcomen requesting Jekyll at the Rook
      scene.
  - id: K1_FIRST_HOME_EXPLORATION
    event: The player sees and explores Jekyll’s home for the first time under authored morning time pressure.
  - id: K1_RESEARCH_AUTO_UPDATE_DAY2
    event: >
      Completing the Day-2 body observation automatically records the brew-method
      observation, first transformation and post-transform physiology and grants
      the canonical K1 research tags. No journal interaction or UI opening is required.    
  - id: K1_CRIME_SCENE_CONSULTATION
    event: Jekyll attends an initial on-site consultation with Inspector Newcomen at the Rook scene.
  decisions:
    K1_BREW:
      options:
        K1_PRECISE:
          action: PRECISE
          strong:
            Potency: 70
            Purity: 80
          costly:
            Potency: 65
            Purity: 65
        K1_FAST:
          action: FAST_FALLBACK
          fixed:
            Potency: 70
            Purity: 55
        K1_RISKY:
          action: RISKY
          fixed:
            Potency: 85
            Purity: 35
            SerumInstabilityScar: 15
    K1_ROOK:
      mode: SYSTEMIC_COMBAT_STYLE_INFERENCE
      player_facing_menu: false
      fixed_truth: Rook always dies after immediate threat ends
      outputs:
      - K1_CONTROLLED
      - K1_CHAOTIC
      - K1_BRUTAL
      tuning: Exact classifier thresholds are downstream combat tuning; TLD supplies qualitative telemetry.
    K1_INTERPRET:
      occurs_after: K1_RELIEF_BEAT if K1ReliefResolved == true
      options: &id001
        K1_RESPONSIBILITY:
          intent: ACCEPT_RESPONSIBILITY
          Integration: 10
          dependence_event: ACCEPT_RESPONSIBILITY
          relationship_to_relief: REJECT_RELIEF_AS_JUSTIFICATION
        K1_RATIONALIZE:
          intent: HE_WAS_EVIL
          Integration: -6
          dependence_delta: 6
          relationship_to_relief: USE_RELIEF_AS_JUSTIFICATION
        K1_SUPPRESS:
          intent: REFUSE_TO_THINK
          Integration: -2
          dependence_delta: 3
          relationship_to_relief: REFUSE_TO_EXAMINE_RELIEF
  fixed_after_Rook:
    RookDead: true
    LedgerMissing: true
    PoliceHeat: 25
    UnderworldHeat: 25
    CrowtherPressure: 10
    IncidentID: INC_K1_ROOK
    HydeGreenBloodAtScene: true
    K1BloodiedCoatExists: true
  research_tags:
  - RD_BASE_TRANSFORMATION
  - RD_POST_TRANSFORM_PHYSIOLOGY
  hard_fails:
  - PLAYER_DEATH
  - DEFINITIVE_CAPTURE
  - SERUM_OVERDOSE
  - SECOND_ROOK_KNIFE_WOUND
  exit:
    next: S1
    required:
    - RookDead == true
    - LedgerMissing == true
    - Form == JEKYLL
    - K1Day2WakeComplete == true
    - K1ResearchGranted == true
    - K1CrimeSceneConsultationComplete == true
    - K1EquippedCoat != K1_BLOODIED_COAT at successful crime-scene consultation
    - If K1NewspaperRead == true, K1ReliefResolved == true
    - If K1ReliefResolved == true, K1InterpretResolved == true
    - If K1NewspaperRead == false, ÚLEVA resolves MISSED at K1 exit
  optional_beats:
  - id: K1_BEGGAR_QUICK_CHOICE
    event: Hyde may terrorize or strike a begging man; timeout resolves to impulsive violence unless NO_TIMER accessibility
      is active.
  - id: K1_POSTBOX_DESTRUCTION
    event: Hyde may destroy one authored street object as a release/physicality beat.
  - id: K1_MIRROR_COAT_DISCOVERY
    event: The hallway mirror can reveal the knife tear and dried green Hyde blood on the previous-night coat.
  - id: K1_NEWSPAPER_READ
    event: Jekyll may read public reporting that Rook was a dangerous underworld figure.
  - id: K1_RELIEF_BEAT
    event: If the newspaper is read, Jekyll involuntarily feels relief and ÚLEVA is fulfilled.
  - id: K1_INTERPRET
    event: If relief occurred, Jekyll may interpret that feeling as RESPONSIBILITY / RATIONALIZE / SUPPRESS.
S0_handoff_contract:
  source: S0_WRITE_LOCK -> S0_LOAD_K1
  required_packet_data:
  - CognitiveImprint
  - ConditionImprint
  - BleedImprint
  - ChemicalImprint
  - MotifPacket
  - ManuscriptFidelity
  - ManuscriptDistortion
  - ManuscriptOverdrive
  - AuthorWeather
  required_S0_motifs:
  - LÁTKA
  - PROMĚNA
  - BOLEST
  - ÚLEVA
  rule: K1 must not recompute S0 author-side medication state after S0 lifecycle clearing. It consumes the values captured
    at S0 write lock. K1 topology does not change because of S0 medication/Fanny choices; those choices modify presentation,
    cognition/render channels and other authored contextual effects through the packet.
  compatibility_note: S0 TLD v1.2 passes AuthorPacket and MotifPacket, but its explicit required_fields list omits AuthorWeather.
    The master states AuthorWeather is generated at write lock and stored in AuthorPacket, so K1 requires it. Add AuthorWeather
    to the S0 handoff required_fields list during the next S0 sync.
manuscript_time_contract:
  source: manuscript_time
  model: AUTHORED_DISCRETE_CLOCK
  purpose: Give K1 coherent diegetic time without a real-time simulation. ManuscriptDay and TimeOfDay are master state. K1LocalClockMinutes
    is a TLD-local authored integer clock in minutes after midnight, used for pacing, prop clocks, house pressure, transit
    and debugging. It advances only on declared authored actions.
  start:
    ManuscriptDay: 1
    TimeOfDay: NIGHT
    K1LocalClockMinutes: 1260
    DisplayTime: '21:00'
  rules:
  - Standing idle, pausing, opening menus, reloading or walking in circles does not advance manuscript time.
  - Declared interactions advance the local clock only on first completion unless explicitly repeatable.
  - ManuscriptDay does not advance through a simulated midnight; the overnight fade commits Day 2 at the authored wake beat.
  - TimeOfDay is authored and not inferred every frame from K1LocalClockMinutes.
  - Prop clocks and transition cards may expose approximate time; a permanent clock HUD is not required.
  authored_durations_minutes:
    K1_OPTIONAL_PRE_EXPERIMENT_JOURNAL: 0
    K1_BREW:
      K1_PRECISE: 20
      K1_FAST: 8
      K1_RISKY: 12
    K1_FIRST_SERUM_INSPECT_AND_COMMIT: 2
    K1_FIRST_TRANSFORMATION_ONSET: 4
    K1_HYDE_STREET_RELEASE: 10
    K1_BEGGAR_QUICK_CHOICE: 2
    K1_POSTBOX_DESTRUCTION: 2
    K1_DARK_ALLEY_SETTLE: 3
    K1_ROOK_LIVE_APPROACH_AND_OPENING: 2
    K1_ROOK_SYSTEMIC_FIGHT: TUNING_3_TO_8
    K1_ROOK_POST_FIGHT_AND_FIXED_DEATH: 3
    K1_DAY2_POOLE_MESSAGE: 10
    K1_DAY2_BODY_CHECK: 10
    K1_DAY2_WARDROBE: 10
    K1_DAY2_MIRROR: 5
    K1_RESEARCH_AUTO_UPDATE_DAY2: 0
    K1_DAY2_BREAKFAST_OR_POOLE_TALK: NOT_USED_IN_CURRENT_K1_TOPOLOGY
    K1_DAY2_MAJOR_HOUSE_INSPECTION: NOT_USED_IN_CURRENT_K1_TOPOLOGY
    K1_DAY2_STREET_TRANSIT: 15
    K1_OPTIONAL_NEWSPAPER: 5
    K1_CRIME_SCENE_CONSULTATION: TUNING_15_TO_25
  approximate_clock_anchors:
    day_1:
      chapter_start: '21:00'
      serum_ready_window: 21:08-21:25
      first_transformation_window: 21:14-21:31
      Hyde_street_and_alley_window: 21:24-21:50
      Rook_encounter_window: 21:35-22:00
      fade_out_window: 21:45-22:10
    day_2:
      Jekyll_wake: 08:30
      Poole_message_complete_approx: 08:40
      free_home_exploration: 08:40-10:30 authored clock
      Poole_warning: 10:15 if still home
      leave_pressure: '10:30'
      street_newspaper_window: 10:30-10:55
      crime_scene_target: about 10:50-11:10
  day_advance:
    trigger: K1_JEKYLL_WAKE_DAY2
    event: ADVANCE_MANUSCRIPT_DAY
    from: 1
    to: 2
    set_TimeOfDay: MORNING
    set_K1LocalClockMinutes: 510
    display_time: 08:30
    idempotent: true
  home_pressure:
    minimum_free_exploration_anchors: 3
    warning_clock_minutes: 615
    warning_display: '10:15'
    leave_pressure_clock_minutes: 630
    leave_pressure_display: '10:30'
    rule: >
      After 10:30 authored time, nonessential house interactions are suppressed
      and Poole/Jekyll repeatedly foreground the need to leave.
      Essential wardrobe and mirror interactions remain available.
      Research Journal access remains optional through the game menu;
      no journal interaction is required before leaving.
  serum_and_medication_time_rules:
  - K1 consumes S0 AuthorPacket values captured at write lock; K1 clock passage does not retroactively recalculate S0 medication.
  - ANALGESIC_A and STIMULANT_S do not receive new continuous duration simulation in this TLD.
  - Serum Potency, Purity, Toxicity, SerumTolerance and TransformFuel remain event/system driven rather than minute driven.
  - TransformFuel is not a real-time timer.
  - K1LocalClockMinutes is authoritative only at authored commit points listed in time_commit_table.
  - A presentation beat may show an approximate time without writing the clock again.
  - A failed attempt reloads the last authored checkpoint and restores its clock snapshot; failed elapsed real time is discarded.
  - The overnight fade is one authored transition, not a minute-by-minute simulation and not a player-idle timeout.
  - K1 does not require a permanent clock HUD. Prop clocks, Poole's reminder and transition cards are sufficient player-facing time cues.
  time_commit_table:
    day_1:
    - event: K1_BOOT
      from: 21:00
      to: 21:00
      write: initialize K1LocalClockMinutes=1260
    - event: K1_BREW_RESOLVE_PRECISE
      duration: 20
      write: advance_once_on_brew_commit
    - event: K1_BREW_RESOLVE_FAST
      duration: 8
      write: advance_once_on_brew_commit
    - event: K1_BREW_RESOLVE_RISKY
      duration: 12
      write: advance_once_on_brew_commit
    - event: K1_FIRST_SERUM_ADMINISTRATION
      duration: 2
      write: advance_once_on_inspect_commit
    - event: K1_FIRST_TRANSFORMATION
      duration: 4
      write: advance_once_on_authored_onset_commit
    - event: K1_HYDE_STREET_RELEASE
      duration: 10
      write: advance_once_on_release_completion
    - event: K1_BEGGAR_QUICK_CHOICE
      duration: 2
      write: advance_once_on_choice_resolution
    - event: K1_POSTBOX_DESTRUCTION
      duration: 2
      write: advance_once_on_first_destroy
    - event: K1_DARK_ALLEY_SETTLE
      duration: 3
      write: advance_once_on_alley_settle
    - event: K1_ROOK_LIVE_APPROACH_AND_OPENING
      duration: 2
      write: advance_once_on_opening_commit
    - event: K1_ROOK_SYSTEMIC_FIGHT
      duration: TUNING_3_TO_8
      write: advance_once_when_fight_resolves
    - event: K1_ROOK_POST_FIGHT_AND_FIXED_DEATH
      duration: 3
      write: advance_once_after_fixed_death_beat
    - event: K1_OVERNIGHT_FADE
      duration: AUTHORED_OFFSCREEN_OVERNIGHT
      write: set_day_2_wake_snapshot; do_not_simulate_minutes
    day_2:
    - event: K1_JEKYLL_WAKE_DAY2
      write: set ManuscriptDay=2, TimeOfDay=MORNING, K1LocalClockMinutes=510
    - event: K1_DAY2_POOLE_MESSAGE
      duration: 10
      write: advance_once_on_message_completion
    - event: K1_DAY2_BODY_CHECK
      duration: 10
      write: advance_once_on_body_observation_completion
    - event: K1_DAY2_WARDROBE
      duration: 10
      write: advance_once_on_first_wardrobe_completion
    - event: K1_DAY2_MIRROR
      duration: 5
      write: advance_once_on_first_mirror_inspection
    - event: K1_DAY2_LAB_DOOR
      duration: 5
      write: advance_once_on_first_lab_door_inspection
    - event: K1_DAY2_WASH
      duration: 20
      write: advance_once_on_first_wash_completion
    - event: K1_OPTIONAL_NEWSPAPER
      duration: 5
      write: advance_once_on_newspaper_read_completion
    - event: K1_DAY2_STREET_TRANSIT
      duration: 15
      write: advance_once_on_front_exit_commit
    - event: K1_CRIME_SCENE_CONSULTATION
