checkpoints:
  CP_S0_START:
    created_at: S0_BOOT
    restores:
    - raw initial Stevenson state
    - acute S-entry reset
    - Fanny offstage
    - no motifs acquired
    - no initial decision
  CP_S0_MED_ROUTE_LOCKED:
    created_at: S0_INITIAL_CHOICE_RESOLVE after route commit and route-specific one-time writes, before medication resolution
    purpose: Lock the player into the chosen S0 medication route while allowing a clean retry of the risky downstream medication
      sequence.
    restores:
    - SelectedS0MedOption
    - S0InitialChoiceResolved = true
    - S0MedRouteLocked = true
    - Stevenson state exactly after route-commit writes
    - BOLEST already acquired
    - Fanny still in the pre-medication route-appropriate state
    - WAIT_FANNY medication-request choice not yet committed at this checkpoint
    - no medication consequence from the failed attempt
    - no LÁTKA / PROMĚNA / ÚLEVA from the failed attempt
    retry_behavior:
      same_route_required: true
      route_reselection_allowed: false
      medication_input_retry_allowed: true
      reapply_route_commit_writes: false
      wait_fanny_request_reselection_allowed: true
    implementation_note: This is an authored TLD checkpoint location. Runtime snapshot/save/reload is implemented later by
      the Unreal/C++ CheckpointSystem and SaveGame layer.
  CP_S0_POST_FANNY:
    created_at: entry to S0_POST_FANNY_FREE_ROAM
    restores:
    - resolved medication route
    - medication consequences
    - Fanny intent result
    - acquired S0 motifs
    - Fanny ambient state
    - writing unlocked state
    - Fanny medication-request relationship write
    - selected S0_FANNY option
    - FannyPostDialogueMode
    - current FannyBond after all S0 relationship writes
    rule: 'Reload must not re-apply medication, duplicate motif acquisition, or re-apply FannyBond/Agitation writes.

      '
fail_handling:
  canonical_hard_fail:
    id: FAIL_STEVENSON_FATAL
    allowed_in_S0: true
    source: hard_fail_matrix.S0
  medication_emergency:
    source: medication.emergency_if
    on_trigger:
    - evaluate medication.rescue_if
    - if rescue valid apply medication.rescue_writes
    - if rescue invalid and fatal handler resolves fatal, execute FAIL_STEVENSON_FATAL
  fail_screen: TBD
  rule: TLD does not invent new fatal thresholds. All thresholds come from MedicationSystem/master. If StevensonFatal occurs
    after S0_MED has been committed, reload CP_S0_MED_ROUTE_LOCKED so the selected route remains locked and the player retries
    that route from a clean snapshot.
  reload_policy: RELOAD_LAST_VALID_AUTHORED_CHECKPOINT
  expected_S0_medication_fatal_target: CP_S0_MED_ROUTE_LOCKED
  fallback_if_route_checkpoint_missing: CP_S0_START
save_contract:
  save_at:
  - CP_S0_START
  - CP_S0_MED_ROUTE_LOCKED
  - CP_S0_POST_FANNY
  - S0_WRITE_LOCK
  minimum_persisted_runtime:
